/*
 * Station + AP credentials for the ESP32 fire controller.
 * Copy to wifi_credentials.h (gitignored) and fill in the ones you want; every
 * define here is optional and each has an equivalent -D build flag.
 *
 * Station (the network the controller joins).  With neither these nor a
 * runtime /network join, the controller runs AP-only.
 */
#define FC_WIFI_SSID    "your-network"
#define FC_WIFI_PASS    "your-password"

/*
 * Fallback access point (raised when no known network is in range).  Set BOTH
 * of these to build an image whose AP credentials are known before the board is
 * ever powered on — no serial capture needed to get onto it.
 *
 *   FC_WIFI_AP_SSID  the entire AP name.  1-32 chars (ESP32 softAP limit).
 *                    Unset -> "FIRE-CONTROL-XXXX", XXXX from the efuse MAC.
 *   FC_WIFI_AP_PASS  the entire AP/API password (also the HTTP Basic password
 *                    for user "admin").  8-23 chars — the same range /appass
 *                    accepts, so a flag-set and a runtime-set password are
 *                    interchangeable.  Unset -> a per-device value derived from
 *                    the MAC and a fixed salt, printed on serial at boot.
 *
 * Out-of-range values are a COMPILE error (static_assert in
 * HMTL_Fire_Control_API.cpp), never a silent truncation: a truncated credential
 * is one you do not know, which is the whole thing these flags exist to avoid.
 *
 * A password set at runtime via /appass (stored in NVS) outranks both of these.
 */
/* Uncomment and set BOTH to build known AP credentials. Left commented on
 * purpose: a copied-verbatim placeholder password would be a real, working
 * credential published in this repo. */
// #define FC_WIFI_AP_SSID "FIRE-CONTROL-WICKERMAN"
// #define FC_WIFI_AP_PASS "choose-your-own-8ch-min"

/*
 * Same thing as build flags instead, e.g. for a one-off image:
 *
 *   PLATFORMIO_BUILD_FLAGS="-DFC_WIFI_AP_SSID='\"FIRE-CONTROL-WICKERMAN\"' \
 *                           -DFC_WIFI_AP_PASS='\"burningman26\"'" \
 *     pio run -e touchcontroller_esp32
 *
 * or permanently in platformio/HMTL_Fire_Control_Wickerman/platformio.ini, by
 * appending to the env's existing build_flags list:
 *
 *   [env:touchcontroller_esp32]
 *   build_flags =
 *       %(GLOBAL_BUILDFLAGS)s
 *       %(ESP32_TOUCH_FLAGS)s
 *       -DFC_WIFI_AP_SSID='"FIRE-CONTROL-WICKERMAN"'
 *       -DFC_WIFI_AP_PASS='"burningman26"'
 *
 * Note both forms need the inner quotes: the value is a C string literal.
 * Anything committed to platformio.ini is in git — prefer wifi_credentials.h
 * (gitignored) for anything you would not publish.
 */
